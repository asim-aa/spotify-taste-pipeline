SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# For local `streamlit run app.py` testing: must be the app's own URL (loopback
# IP, not "localhost" — Spotify no longer accepts that hostname).
# For `python features.py` (CLI, single-user): any registered loopback URI works.
# For a Streamlit Cloud deployment: the deployed https://<app-name>.streamlit.app URL.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501

# Your Spotify user ID — the only visitor whose data persists to disk when
# running app.py. Get it by running:
#   python3 -c "from spotify_client import get_spotify_client; print(get_spotify_client().current_user()['id'])"
OWNER_SPOTIFY_ID=your_spotify_user_id_here

# For insights.py (LLM listener-summary/recommendations). Two providers,
# switched via LLM_PROVIDER (default "anthropic" if unset):
LLM_PROVIDER=anthropic

# Provider "anthropic": get a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Provider "supportvectors": an OpenAI-compatible gateway (e.g. a bootcamp-
# provided endpoint). Requires being on the required network/VPN if applicable.
# SUPPORTVECTORS_BASE_URL=your_supportvectors_base_url_here
# SUPPORTVECTORS_API_KEY=your_supportvectors_api_key_here
# SUPPORTVECTORS_MODEL=openai/gpt-oss-20b

# insights.py skips gracefully with a clear message if the active provider's
# config is missing, rather than crashing.

# Durability fix for the deployed owner path: Streamlit Cloud's local
# filesystem isn't guaranteed to survive a container restart, so the owner's
# data/labels.csv and data/learning_curve.csv are periodically committed back
# to this GitHub repo via the Contents API (every 10 labels, plus a manual
# "Sync to GitHub now" sidebar button). Only used for the OWNER's data sync
# on the deployed instance — testers' data never touches this path, since
# it's never written to disk for them in the first place.
#
# GITHUB_TOKEN: a fine-grained personal access token
# (https://github.com/settings/personal-access-tokens/new), scoped to just
# this one repository, with "Contents" permission set to Read and write.
# No broader scopes are needed.
# GITHUB_REPO: "owner/repo", e.g. asim-aa/spotify-taste-pipeline.
GITHUB_TOKEN=your_github_fine_grained_pat_here
GITHUB_REPO=your_github_username/your_repo_name
